# Public Supabase project settings used for read-only dashboard queries.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only credentials used by the authenticated daily scraper.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-random-secret-of-at-least-16-characters

# Optional comma-separated provider list. The public Base RPC remains a fallback.
BASE_RPC_URLS=https://your-primary-base-rpc.example,https://your-secondary-base-rpc.example
BASE_RPC_PROVIDER_LABEL=managed-base-rpc
